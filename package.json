{
  "name": "rezeptly",
  "private": true,
  "version": "1.8.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev --open",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node --env-file=.env --import tsx src/lib/server/db/seed.ts",
    "release": "release-it",
    "test:unit": "vitest",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test": "npm run test:unit -- --run",
    "prepare": "svelte-kit sync && husky"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "^10.0.6",
    "@shadcn/lint": "^0.2.3",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/load-config": "^0.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^4.1.12",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "release-it": "^19.2.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-devtools-json": "^1.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vitest-browser-svelte": "^2.2.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@ai-sdk/svelte": "^5.0.154",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.154",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.9",
    "runed": "^0.38.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "svelte-sonner": "^1.2.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@11.20.0",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
